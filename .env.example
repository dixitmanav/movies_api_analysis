# Copy this file to .env and paste in your own keys (no quotes, no spaces)
# TMDb:  https://www.themoviedb.org/settings/api  (use the "API Key", not the long token)
# OMDb:  https://www.omdbapi.com/apikey.aspx  (FREE plan, activate the key from the email)
TMDB_API_KEY=
OMDB_API_KEY=
# Optional, for backfill_movies.py: several OMDb keys, comma-separated, no spaces.
# If set, the backfill uses these instead of OMDB_API_KEY.
# OMDB_API_KEYS=key1,key2,key3
